# ═══════════════════════════════════════════════════════════════════════════
#   ShopMind Backend — Environment Variables
#   Copy this file to .env and fill in your values.
#   Spring Boot loads .env automatically via spring-dotenv (no export needed).
# ═══════════════════════════════════════════════════════════════════════════

# ─── Database ────────────────────────────────────────────────────────────────
# Leave all DB_* vars unset to use H2 in-memory (local dev, no setup needed).
# Fill these in to connect to Neon / any PostgreSQL instance.
DB_URL=jdbc:postgresql://your-host.neon.tech/neondb?sslmode=require
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_DRIVER=org.postgresql.Driver

# ─── AI Provider ─────────────────────────────────────────────────────────────
# Choose one: groq | gemini | mock
# mock = no API key needed, instant keyword-matching responses
SHOPMIND_AI_PROVIDER=groq

# ─── Groq (recommended — fast, 30 RPM free tier) ─────────────────────────────
# Get a free key (no credit card): https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
# Options: llama-3.3-70b-versatile | llama3-8b-8192 | mixtral-8x7b-32768
GROQ_MODEL=llama-3.3-70b-versatile

# ─── Gemini (alternative — 15 RPM free tier) ─────────────────────────────────
# Get a free key: https://aistudio.google.com/app/apikey
# Only needed when SHOPMIND_AI_PROVIDER=gemini
GOOGLE_API_KEY=your_google_api_key_here
# Options: gemini-2.0-flash | gemini-2.0-flash-lite | gemini-1.5-pro
GEMINI_MODEL=gemini-2.0-flash

# ─── Shared LLM tuning ───────────────────────────────────────────────────────
LLM_MAX_TOKENS=2048

# ─── Shopify (optional — leave as mock to use the built-in CSV catalog) ──────
# Your store domain e.g. your-store.myshopify.com
SHOPIFY_STORE_DOMAIN=mock
# Storefront access token — must start with shpat_
# Set to mock to use the 51-product nike_products.csv catalog
SHOPIFY_STOREFRONT_TOKEN=mock

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# ─── Logging ─────────────────────────────────────────────────────────────────
# Levels: TRACE | DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO

# ─── H2 Console (dev only) ───────────────────────────────────────────────────
# When true, browse the in-memory DB at http://localhost:8080/h2-console
# JDBC URL: jdbc:h2:mem:shopmind  User: sa  Password: (blank)
H2_CONSOLE_ENABLED=false
